# Copy to .env and fill in. Never commit .env.

# IP address of your IQ Gateway (Envoy). Use the IP, not envoy.local, when running in Docker.
ENVOY_HOST=192.168.1.50

# Your local time zone - daily totals reset at local midnight.
TZ=America/New_York

# Optional: require this password (any username) to open the dashboard.
DASHBOARD_PASSWORD=

# Optional: Enphase cloud API (developer-v4.enphase.com) for backfill and EV charger data.
ENPHASE_API_KEY=
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=

# Optional: AI suggestions for naming appliances (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: publish to Home Assistant via MQTT (discovery is automatic).
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
